{
  "name": "dsh-relay-models",
  "version": "1.0.0",
  "description": "Fill custom-provider model capabilities from https://pi.dev/api/models",
  "type": "module",
  "license": "MIT",
  "author": "Xichun123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xichun123/dsh-relay-models.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test:harness": "node scripts/test-harness.mjs && node scripts/test-client.mjs",
    "validate": "pnpm test && pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "effect": "^3.22.1"
  }
}
