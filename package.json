{
  "name": "dsh-relay-models",
  "version": "0.6.0",
  "description": "Fill custom-provider model capabilities from https://pi.dev/api/models",
  "type": "module",
  "license": "MIT",
  "author": "Xichun123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xichun123/dsh-relay-models.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "test": "node --experimental-strip-types --test src/enrich.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.15.0"
}
